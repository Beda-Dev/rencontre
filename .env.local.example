# Copy to .env.local to switch from mock data to your own backend.

# false = use your real API instead of the built-in mock data
NEXT_PUBLIC_USE_MOCK=true

# Base URL of *your own* backend/proxy (never point this at a third-party
# service's private API directly from the browser — proxy it server-side).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Google OAuth Client ID (create one free at https://console.cloud.google.com
# -> APIs & Services -> Credentials -> OAuth client ID -> Web application).
# Only used when NEXT_PUBLIC_USE_MOCK=false — enables the real "Continue
# with Google" button (Google Identity Services). Leave empty to keep it
# as a disabled/stub button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Gemini API keys (https://aistudio.google.com/apikey). Server-side only —
# never prefixed with NEXT_PUBLIC_, so they are never sent to the browser.
# They are tried in order: if one fails (quota, 429, 5xx, network), the next
# one is used automatically. At least one is required for the AI features.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional: model used for every AI feature (default below).
GEMINI_MODEL=gemini-3.5-flash
